        { "type": "textarea", "id": "subtitle",      "label": "Subtitle (ES)",         "default": "Nacida en la tierra de Fangio. Construida con la precisión de quienes nunca aceptaron el segundo lugar." },
        { "type": "textarea", "id": "subtitle_en",   "label": "Subtitle (EN)",         "default": "Born on Fangio's land. Built with the precision of those who never accepted second place." },
        { "type": "text",     "id": "coordinates",   "label": "Coordinates",           "default": "37°50′ S  58°15′ O" },
        { "type": "text",     "id": "meta_1_label",    "label": "Meta 1 Label (ES)",   "default": "Colección" },
        { "type": "text",     "id": "meta_1_label_en", "label": "Meta 1 Label (EN)",   "default": "Collection" },
        { "type": "text",     "id": "meta_1_value",    "label": "Meta 1 Value",        "default": "SS 2026" },
        { "type": "text",     "id": "meta_2_label",    "label": "Meta 2 Label (ES)",   "default": "Material" },
        { "type": "text",     "id": "meta_2_label_en", "label": "Meta 2 Label (EN)",   "default": "Material" },
        { "type": "text",     "id": "meta_2_value",    "label": "Meta 2 Value (ES)",   "default": "Lino Puro" },
        { "type": "text",     "id": "meta_2_value_en", "label": "Meta 2 Value (EN)",   "default": "Pure Linen" },
        { "type": "text",     "id": "meta_3_label",    "label": "Meta 3 Label (ES)",   "default": "Origen" },
        { "type": "text",     "id": "meta_3_label_en", "label": "Meta 3 Label (EN)",   "default": "Origin" },
        { "type": "text",     "id": "meta_3_value",    "label": "Meta 3 Value",        "default": "Balcarce" }
      ]
    },
    {
      "type": "logo_reveal",
      "name": "Logo Reveal",
