<style>
/* ══════════════════════════════════════════════════════════
   LUX ABOUT — BASE
══════════════════════════════════════════════════════════ */
:root {
  --lux-bg          : {{ section.settings.bg_color }};
  --lux-fg          : {{ section.settings.text_color }};
  --lux-font-head   : 'Cormorant Garamond', Georgia, serif;
  --lux-font-body   : 'Jost', 'Helvetica Neue', Arial, sans-serif;
  --lux-gold        : #c9a96e;
  --lux-gold-light  : #e8d5b0;
  --lux-easing      : cubic-bezier(0.16, 1, 0.3, 1);
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

.lux-wrapper {
  background  : var(--lux-bg);
  color       : var(--lux-fg);
  font-family : var(--lux-font-body);
  overflow-x  : hidden;
}

/* ══════════════════════════════════════════════════════════
   HERO
══════════════════════════════════════════════════════════ */
.lux-hero {
  position         : relative;
  min-height       : 100vh;
  display          : flex;
  flex-direction   : column;
  justify-content  : center;
  align-items      : center;
  text-align       : center;
  padding          : 120px 5% 80px;
  overflow         : hidden;
}

.lux-hero::before {
  content    : '';
  position   : absolute;
  inset      : 0;
  background : radial-gradient(ellipse at center, rgba(201,169,110,0.06) 0%, transparent 70%);
  pointer-events : none;
}

.lux-hero__eyebrow {
  font-family    : var(--lux-font-body);
  font-size      : 0.58rem;
  letter-spacing : 0.45em;
  text-transform : uppercase;
  color          : var(--lux-gold);
  margin-bottom  : 2.5rem;
  opacity        : 0;
  transform      : translateY(20px);
  transition     : opacity 0.8s var(--lux-easing), transform 0.8s var(--lux-easing);
}

.lux-hero__title {
  font-family    : var(--lux-font-head);
  font-size      : clamp(3.5rem, 10vw, 9rem);
  font-weight    : 300;
  letter-spacing : 0.08em;
  line-height    : 1;
  color          : var(--lux-fg);
  margin-bottom  : 2.5rem;
  opacity        : 0;
  transform      : translateY(30px);
  transition     : opacity 0.9s 0.1s var(--lux-easing), transform 0.9s 0.1s var(--lux-easing);
}

.lux-hero__subtitle {
  font-family    : var(--lux-font-head);
  font-size      : clamp(1rem, 2vw, 1.4rem);
  font-weight    : 300;
  font-style     : italic;
  line-height    : 1.6;
  max-width      : 680px;
  color          : rgba(240,236,230,0.72);
  margin-bottom  : 4rem;
  opacity        : 0;
  transform      : translateY(20px);
  transition     : opacity 0.9s 0.2s var(--lux-easing), transform 0.9s 0.2s var(--lux-easing);
}

.lux-hero__coords {
  font-family    : var(--lux-font-body);
  font-size      : 0.55rem;
  letter-spacing : 0.38em;
  text-transform : uppercase;
  color          : rgba(240,236,230,0.35);
  margin-bottom  : 5rem;
}

.lux-hero__meta {
  display        : flex;
  gap            : 3.5rem;
  justify-content: center;
  flex-wrap      : wrap;
  opacity        : 0;
  transform      : translateY(20px);
  transition     : opacity 0.9s 0.35s var(--lux-easing), transform 0.9s 0.35s var(--lux-easing);
}

.lux-hero__meta-item {
  display        : flex;
  flex-direction : column;
  align-items    : center;
  gap            : 0.5rem;
}

.lux-hero__meta-label {
  font-size      : 0.5rem;
  letter-spacing : 0.4em;
  text-transform : uppercase;
  color          : var(--lux-gold);
}

.lux-hero__meta-value {
  font-family    : var(--lux-font-head);
  font-size      : 1.1rem;
  font-weight    : 300;
  letter-spacing : 0.1em;
  color          : var(--lux-fg);
}

.lux-hero.is-visible .lux-hero__eyebrow,
.lux-hero.is-visible .lux-hero__title,
.lux-hero.is-visible .lux-hero__subtitle,
.lux-hero.is-visible .lux-hero__meta {
  opacity   : 1;
  transform : translateY(0);
}

/* ══════════════════════════════════════════════════════════
   LOGO REVEAL
══════════════════════════════════════════════════════════ */
.lux-logo-reveal {
  position       : relative;
  padding        : 12vw 5%;
  text-align     : center;
  overflow       : hidden;
}

.lux-logo-reveal__ghost {
  position       : absolute;
  top            : 50%;
  left           : 50%;
  transform      : translate(-50%, -50%);
  font-family    : var(--lux-font-head);
  font-size      : clamp(8rem, 28vw, 22rem);
  font-weight    : 300;
  letter-spacing : 0.05em;
  color          : rgba(201,169,110,0.04);
  user-select    : none;
  pointer-events : none;
  white-space    : nowrap;
}

.lux-logo-reveal__brand {
  font-family    : var(--lux-font-head);
  font-size      : clamp(2.2rem, 6vw, 5.5rem);
  font-weight    : 300;
  letter-spacing : 0.18em;
  text-transform : uppercase;
  color          : var(--lux-fg);
  position       : relative;
  z-index        : 1;
}

.lux-logo-reveal__caption {
  font-family    : var(--lux-font-body);
  font-size      : 0.52rem;
  letter-spacing : 0.42em;
  text-transform : uppercase;
  color          : var(--lux-gold);
  margin-top     : 1.5rem;
  position       : relative;
  z-index        : 1;
}

/* ══════════════════════════════════════════════════════════
   MANIFESTO
══════════════════════════════════════════════════════════ */
.lux-manifesto {
  position       : relative;
  padding        : 10vw 8%;
  overflow       : hidden;
}

.lux-manifesto__ghost {
  position       : absolute;
  top            : 50%;
  right          : -2%;
  transform      : translateY(-50%);
  font-family    : var(--lux-font-head);
  font-size      : clamp(12rem, 35vw, 28rem);
  font-weight    : 300;
  color          : rgba(201,169,110,0.03);
  user-select    : none;
  pointer-events : none;
  line-height    : 1;
}

.lux-manifesto__label {
  font-family    : var(--lux-font-body);
  font-size      : 0.52rem;
  letter-spacing : 0.42em;
  text-transform : uppercase;
  color          : var(--lux-gold);
  margin-bottom  : 3rem;
}

.lux-manifesto__statement {
  font-family    : var(--lux-font-head);
  font-size      : clamp(1.5rem, 3.5vw, 2.8rem);
  font-weight    : 300;
  line-height    : 1.55;
  max-width      : 820px;
  position       : relative;
  z-index        : 1;
}

.lux-manifesto__statement em  { font-style: italic; color: var(--lux-gold-light); }
.lux-manifesto__statement strong { font-weight: 400; }

.lux-manifesto__footer {
  margin-top     : 4rem;
  padding-top    : 2rem;
  border-top     : 1px solid rgba(201,169,110,0.18);
  font-family    : var(--lux-font-body);
  font-size      : 0.78rem;
  letter-spacing : 0.12em;
  line-height    : 1.8;
  color          : rgba(240,236,230,0.52);
  max-width      : 620px;
}

/* ══════════════════════════════════════════════════════════
   PILLARS
══════════════════════════════════════════════════════════ */
.lux-pillars {
  padding        : 8vw 5%;
  border-top     : 1px solid rgba(201,169,110,0.1);
  border-bottom  : 1px solid rgba(201,169,110,0.1);
}

.lux-pillars__grid {
  display               : grid;
  grid-template-columns : repeat(auto-fit, minmax(240px, 1fr));
  gap                   : 4rem 3rem;
}

.lux-pillar__number {
  font-family    : var(--lux-font-head);
  font-size      : clamp(2.8rem, 6vw, 4.5rem);
  font-weight    : 300;
  color          : var(--lux-gold);
  line-height    : 1;
  margin-bottom  : 0.8rem;
}

.lux-pillar__label {
  font-family    : var(--lux-font-body);
  font-size      : 0.55rem;
  letter-spacing : 0.38em;
  text-transform : uppercase;
  color          : var(--lux-fg);
  margin-bottom  : 1.2rem;
}

.lux-pillar__text {
  font-family    : var(--lux-font-head);
  font-size      : 1rem;
  font-weight    : 300;
  font-style     : italic;
  line-height    : 1.65;
  color          : rgba(240,236,230,0.6);
}

/* ══════════════════════════════════════════════════════════
   SPLIT CONTENT
══════════════════════════════════════════════════════════ */
.lux-split {
  display        : grid;
  grid-template-columns : 1fr 1fr;
  min-height     : 70vh;
}

@media (max-width: 768px) {
  .lux-split { grid-template-columns: 1fr; }
}

.lux-split__text {
  padding        : 8vw 6%;
  display        : flex;
  flex-direction : column;
  justify-content: center;
}

.lux-split__chapter {
  font-family    : var(--lux-font-body);
  font-size      : 0.52rem;
  letter-spacing : 0.42em;
  text-transform : uppercase;
  color          : var(--lux-gold);
  margin-bottom  : 2.5rem;
}

.lux-split__title {
  font-family    : var(--lux-font-head);
  font-size      : clamp(2rem, 4.5vw, 3.8rem);
  font-weight    : 300;
  letter-spacing : 0.04em;
  line-height    : 1.1;
  margin-bottom  : 2rem;
  color          : var(--lux-fg);
}

.lux-split__body {
  font-family    : var(--lux-font-head);
  font-size      : clamp(0.95rem, 1.5vw, 1.15rem);
  font-weight    : 300;
  line-height    : 1.85;
  color          : rgba(240,236,230,0.65);
}

.lux-split__visual {
  position       : relative;
  background     : rgba(201,169,110,0.04);
  display        : flex;
  align-items    : flex-end;
  justify-content: flex-end;
  padding        : 2rem;
  min-height     : 480px;
}

.lux-split__visual-label {
  font-family    : var(--lux-font-body);
  font-size      : 0.48rem;
  letter-spacing : 0.35em;
  text-transform : uppercase;
  color          : rgba(240,236,230,0.28);
}

/* ══════════════════════════════════════════════════════════
   MARQUEE
══════════════════════════════════════════════════════════ */
.lux-marquee {
  overflow       : hidden;
  padding        : 3rem 0;
  border-top     : 1px solid rgba(201,169,110,0.1);
  border-bottom  : 1px solid rgba(201,169,110,0.1);
}

.lux-marquee__track {
  display        : flex;
  width          : max-content;
  animation      : marquee 28s linear infinite;
  gap            : 0;
}

.lux-marquee__track--reverse {
  animation-direction : reverse;
}

@keyframes marquee {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.lux-marquee__item {
  font-family    : var(--lux-font-head);
  font-size      : clamp(0.8rem, 1.4vw, 1.1rem);
  font-weight    : 300;
  letter-spacing : 0.22em;
  text-transform : uppercase;
  color          : rgba(240,236,230,0.35);
  padding        : 0 2.5rem;
  white-space    : nowrap;
}

/* ══════════════════════════════════════════════════════════
   FULL MEDIA
══════════════════════════════════════════════════════════ */
.lux-full-media {
  position       : relative;
  min-height     : 90vh;
  display        : flex;
  align-items    : center;
  justify-content: center;
  overflow       : hidden;
  background     : #050505;
}

.lux-full-media__words {
  display        : flex;
  flex-direction : column;
  align-items    : center;
  gap            : 0;
  z-index        : 1;
}

.lux-full-media__word {
  font-family    : var(--lux-font-head);
  font-size      : clamp(4rem, 14vw, 12rem);
  font-weight    : 300;
  letter-spacing : 0.06em;
  line-height    : 0.9;
  color          : rgba(240,236,230,0.08);
  text-transform : uppercase;
  transition     : color 0.6s var(--lux-easing);
}

.lux-full-media:hover .lux-full-media__word { color: rgba(240,236,230,0.14); }

.lux-full-media__caption {
  position       : absolute;
  bottom         : 2.5rem;
  right          : 3rem;
  font-family    : var(--lux-font-body);
  font-size      : 0.48rem;
  letter-spacing : 0.35em;
  text-transform : uppercase;
  color          : rgba(240,236,230,0.22);
}

/* ══════════════════════════════════════════════════════════
   TIMELINE
══════════════════════════════════════════════════════════ */
.lux-timeline {
  padding        : 8vw 5%;
}

.lux-timeline__header {
  margin-bottom  : 6rem;
}

.lux-timeline__title {
  font-family    : var(--lux-font-head);
  font-size      : clamp(2rem, 4.5vw, 3.8rem);
  font-weight    : 300;
  letter-spacing : 0.04em;
  margin-bottom  : 1.5rem;
  color          : var(--lux-fg);
}

.lux-timeline__intro {
  font-family    : var(--lux-font-head);
  font-size      : clamp(0.9rem, 1.4vw, 1.1rem);
  font-weight    : 300;
  font-style     : italic;
  color          : rgba(240,236,230,0.5);
  max-width      : 520px;
}

.lux-timeline__list {
  position       : relative;
  padding-left   : 2.5rem;
}

.lux-timeline__list::before {
  content    : '';
  position   : absolute;
  left       : 0;
  top        : 0;
  bottom     : 0;
  width      : 1px;
  background : rgba(201,169,110,0.2);
}

.lux-timeline__event {
  position       : relative;
  padding        : 0 0 4.5rem 3rem;
}

.lux-timeline__event::before {
  content    : '';
  position   : absolute;
  left       : -3px;
  top        : 8px;
  width      : 7px;
  height     : 7px;
  border-radius : 50%;
  background : var(--lux-gold);
}

.lux-timeline__year {
  font-family    : var(--lux-font-body);
  font-size      : 0.52rem;
  letter-spacing : 0.42em;
  text-transform : uppercase;
  color          : var(--lux-gold);
  margin-bottom  : 0.6rem;
}

.lux-timeline__event-title {
  font-family    : var(--lux-font-head);
  font-size      : clamp(1.2rem, 2.5vw, 1.8rem);
  font-weight    : 300;
  color          : var(--lux-fg);
  margin-bottom  : 0.8rem;
  line-height    : 1.2;
}

.lux-timeline__desc {
  font-family    : var(--lux-font-head);
  font-size      : 1rem;
  font-weight    : 300;
  font-style     : italic;
  line-height    : 1.75;
  color          : rgba(240,236,230,0.55);
  max-width      : 600px;
}

/* ══════════════════════════════════════════════════════════
   PHILOSOPHY
══════════════════════════════════════════════════════════ */
.lux-philosophy {
  padding        : 8vw 5%;
  background     : rgba(201,169,110,0.025);
}

.lux-philosophy__header {
  margin-bottom  : 5rem;
}

.lux-philosophy__label {
  font-family    : var(--lux-font-body);
  font-size      : 0.52rem;
  letter-spacing : 0.42em;
  text-transform : uppercase;
  color          : var(--lux-gold);
  margin-bottom  : 1.5rem;
}

.lux-philosophy__title {
  font-family    : var(--lux-font-head);
  font-size      : clamp(2rem, 4.5vw, 3.8rem);
  font-weight    : 300;
  letter-spacing : 0.04em;
  color          : var(--lux-fg);
  margin-bottom  : 1.5rem;
}

.lux-philosophy__subtitle {
  font-family    : var(--lux-font-head);
  font-size      : clamp(0.9rem, 1.4vw, 1.1rem);
  font-weight    : 300;
  font-style     : italic;
  color          : rgba(240,236,230,0.52);
  max-width      : 600px;
  line-height    : 1.7;
}

.lux-philosophy__cards {
  display               : grid;
  grid-template-columns : repeat(auto-fit, minmax(280px, 1fr));
  gap                   : 2px;
}

.lux-philosophy__card {
  padding        : 3.5rem 2.8rem;
  border         : 1px solid rgba(201,169,110,0.1);
  transition     : background 0.4s ease, border-color 0.4s ease;
}

.lux-philosophy__card:hover {
  background     : rgba(201,169,110,0.04);
  border-color   : rgba(201,169,110,0.22);
}

.lux-philosophy__card-title {
  font-family    : var(--lux-font-head);
  font-size      : 1.5rem;
  font-weight    : 300;
  color          : var(--lux-fg);
  margin-bottom  : 1.5rem;
}

.lux-philosophy__card-text {
  font-family    : var(--lux-font-head);
  font-size      : 0.98rem;
  font-weight    : 300;
  font-style     : italic;
  line-height    : 1.8;
  color          : rgba(240,236,230,0.58);
}

/* ══════════════════════════════════════════════════════════
   TEAM
══════════════════════════════════════════════════════════ */
.lux-team {
  padding        : 8vw 5%;
}

.lux-team__header {
  margin-bottom  : 5rem;
}

.lux-team__label {
  font-family    : var(--lux-font-body);
  font-size      : 0.52rem;
  letter-spacing : 0.42em;
  text-transform : uppercase;
  color          : var(--lux-gold);
  margin-bottom  : 1.5rem;
}

.lux-team__title {
  font-family    : var(--lux-font-head);
  font-size      : clamp(2rem, 4.5vw, 3.8rem);
  font-weight    : 300;
  letter-spacing : 0.04em;
  color          : var(--lux-fg);
  margin-bottom  : 1.5rem;
}

.lux-team__intro {
  font-family    : var(--lux-font-head);
  font-size      : clamp(0.9rem, 1.4vw, 1.1rem);
  font-weight    : 300;
  font-style     : italic;
  color          : rgba(240,236,230,0.52);
  max-width      : 580px;
  line-height    : 1.7;
}

.lux-team__grid {
  display               : grid;
  grid-template-columns : repeat(auto-fit, minmax(300px, 1fr));
  gap                   : 4rem 3rem;
}

.lux-team__member-name {
  font-family    : var(--lux-font-head);
  font-size      : 1.6rem;
  font-weight    : 300;
  color          : var(--lux-fg);
  margin-bottom  : 0.4rem;
}

.lux-team__member-role {
  font-family    : var(--lux-font-body);
  font-size      : 0.52rem;
  letter-spacing : 0.35em;
  text-transform : uppercase;
  color          : var(--lux-gold);
  margin-bottom  : 0.6rem;
}

.lux-team__member-tag {
  font-family    : var(--lux-font-body);
  font-size      : 0.55rem;
  letter-spacing : 0.28em;
  color          : rgba(240,236,230,0.3);
  margin-bottom  : 1.8rem;
}

.lux-team__member-bio {
  font-family    : var(--lux-font-head);
  font-size      : 1rem;
  font-weight    : 300;
  font-style     : italic;
  line-height    : 1.8;
  color          : rgba(240,236,230,0.58);
}

/* ══════════════════════════════════════════════════════════
   AWARDS
══════════════════════════════════════════════════════════ */
.lux-awards {
  padding        : 7vw 5%;
  border-top     : 1px solid rgba(201,169,110,0.1);
}

.lux-awards__label {
  font-family    : var(--lux-font-body);
  font-size      : 0.52rem;
  letter-spacing : 0.42em;
  text-transform : uppercase;
  color          : var(--lux-gold);
  margin-bottom  : 1.5rem;
  text-align     : center;
}

.lux-awards__title {
  font-family    : var(--lux-font-head);
  font-size      : clamp(1.8rem, 3.5vw, 3rem);
  font-weight    : 300;
  letter-spacing : 0.04em;
  color          : var(--lux-fg);
  text-align     : center;
  margin-bottom  : 4rem;
}

.lux-awards__list {
  display        : flex;
  flex-wrap      : wrap;
  justify-content: center;
  gap            : 2.5rem 5rem;
}

.lux-awards__item {
  text-align     : center;
}

.lux-awards__pub {
  font-family    : var(--lux-font-head);
  font-size      : 1.2rem;
  font-weight    : 300;
  color          : rgba(240,236,230,0.45);
  transition     : color 0.3s ease;
}

.lux-awards__pub:hover { color: var(--lux-fg); }

.lux-awards__year {
  font-family    : var(--lux-font-body);
  font-size      : 0.5rem;
  letter-spacing : 0.35em;
  color          : var(--lux-gold);
  margin-top     : 0.4rem;
}

/* ══════════════════════════════════════════════════════════
   QUOTE
══════════════════════════════════════════════════════════ */
.lux-quote {
  padding        : 8vw 8%;
  text-align     : center;
  position       : relative;
}

.lux-quote__text {
  font-family    : var(--lux-font-head);
  font-size      : clamp(1.4rem, 3vw, 2.5rem);
  font-weight    : 300;
  font-style     : italic;
  line-height    : 1.6;
  color          : var(--lux-fg);
  max-width      : 820px;
  margin         : 0 auto 3rem;
}

.lux-quote__source {
  font-family    : var(--lux-font-body);
  font-size      : 0.52rem;
  letter-spacing : 0.38em;
  text-transform : uppercase;
  color          : var(--lux-gold);
}

/* ══════════════════════════════════════════════════════════
   SIGNATURE
══════════════════════════════════════════════════════════ */
.lux-signature {
  padding        : 8vw 5%;
  text-align     : center;
  border-top     : 1px solid rgba(201,169,110,0.1);
}

.lux-signature__label {
  font-family    : var(--lux-font-body);
  font-size      : 0.52rem;
  letter-spacing : 0.42em;
  text-transform : uppercase;
  color          : var(--lux-gold);
  margin-bottom  : 2.5rem;
}

.lux-signature__brand {
  font-family    : var(--lux-font-head);
  font-size      : clamp(2.5rem, 7vw, 6rem);
  font-weight    : 300;
  letter-spacing : 0.15em;
  text-transform : uppercase;
  color          : var(--lux-fg);
  margin-bottom  : 1.5rem;
}

.lux-signature__tagline {
  font-family    : var(--lux-font-head);
  font-size      : clamp(0.9rem, 1.5vw, 1.15rem);
  font-weight    : 300;
  font-style     : italic;
  color          : rgba(240,236,230,0.45);
  margin-bottom  : 3.5rem;
}

.lux-signature__meta {
  display        : flex;
  justify-content: center;
  gap            : 4rem;
  flex-wrap      : wrap;
}

.lux-signature__meta-item {
  display        : flex;
  flex-direction : column;
  gap            : 0.5rem;
}

.lux-signature__meta-label {
  font-family    : var(--lux-font-body);
  font-size      : 0.48rem;
  letter-spacing : 0.38em;
  text-transform : uppercase;
  color          : rgba(240,236,230,0.28);
}

.lux-signature__meta-value {
  font-family    : var(--lux-font-head);
  font-size      : 1rem;
  font-weight    : 300;
  color          : rgba(240,236,230,0.65);
}

/* ══════════════════════════════════════════════════════════
   LANGUAGE SWITCHER
══════════════════════════════════════════════════════════ */
.lux-lang {
  position       : fixed;
  top            : 28px;
  right          : 8%;
  z-index        : 9500;
  display        : flex;
  align-items    : center;
  gap            : 10px;
  mix-blend-mode : difference;
}

.lux-lang__btn {
  font-family    : var(--lux-font-body);
  font-size      : 0.52rem;
  letter-spacing : 0.32em;
  text-transform : uppercase;
  color          : rgba(255,255,255,0.42);
  background     : transparent;
  border         : none;
  cursor         : pointer;
  padding        : 4px 0;
  transition     : color 0.3s ease, opacity 0.3s ease;
}

.lux-lang__btn[aria-pressed="true"] {
  color   : #ffffff;
  opacity : 1;
}

.lux-lang__btn:hover { color: #ffffff; opacity: 0.78; }

.lux-lang__sep {
  width         : 1px;
  height        : 10px;
  background    : rgba(255,255,255,0.22);
  display       : block;
  flex-shrink   : 0;
}

/* Hide/show language blocks */
[data-lang-block] { display: none; }
[data-lang-block].is-lang-active { display: block; }
/* For inline elements (e.g. <span> inside running text — use data-lang-inline instead of data-lang-block) */
[data-lang-inline] { display: none; }
[data-lang-inline].is-lang-active { display: inline; }
</style>

<div class="lux-wrapper">

  {% for block in section.blocks %}

    {% case block.type %}

    {% when 'hero' %}
    <section class="lux-hero" {{ block.shopify_attributes }}>
