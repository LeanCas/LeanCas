      "options": [
        { "value": "es", "label": "Español" },
        { "value": "en", "label": "English" }
      ],
      "default": "es"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0a0a0a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#f0ece6"
    }
  ],
  "blocks": [
