<script>
(function () {
  'use strict';

  /* ── 1 · HERO ENTRANCE ──────────────────────────── */
  var hero = document.querySelector('.lux-hero');
  if (hero) {
    var heroObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) { entry.target.classList.add('is-visible'); }
      });
    }, { threshold: 0.15 });
    heroObserver.observe(hero);
  }

  /* ── 18 · LANGUAGE TOGGLE ─────────────────────────── */
  (function () {
    var defaultLang = '{{ section.settings.default_language | default: "es" }}';
    var langBtns    = document.querySelectorAll('.lux-lang__btn');
    var langBlocks  = document.querySelectorAll('[data-lang-block]');
    var langInlines = document.querySelectorAll('[data-lang-inline]');

    function setLang(lang) {
      langBlocks.forEach(function (el) {
        el.classList.toggle('is-lang-active', el.getAttribute('data-lang-block') === lang);
      });
      langInlines.forEach(function (el) {
        el.classList.toggle('is-lang-active', el.getAttribute('data-lang-inline') === lang);
      });
      langBtns.forEach(function (btn) {
        btn.setAttribute('aria-pressed', btn.getAttribute('data-lang') === lang ? 'true' : 'false');
      });
      try { localStorage.setItem('luxLang', lang); } catch (e) {}
    }

    var saved = '';
    try { saved = localStorage.getItem('luxLang') || ''; } catch (e) {}
    setLang(saved || defaultLang);

    langBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        setLang(btn.getAttribute('data-lang'));
      });
    });
  }());

}());
</script>

